{
  "name": "react",
  "version": "1.0.0",
  "description": "",
  "keywords": [],
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.105.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "jsdom": "30.1.1",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "playwright": "1.63.0"
  },
  "scripts": {
    "start": "vite",
    "build": "node scripts/build.cjs",
    "test": "npm run test:unit && npm run test:static",
    "test:unit": "vitest run",
    "test:setup": "node tests/backend/setup.cjs",
    "test:db": "node --test --test-concurrency=1 tests/backend/integration.test.cjs",
    "test:e2e": "node --test --test-concurrency=1 tests/browser/e2e.test.cjs",
    "test:config": "node --test tests/config/*.test.cjs",
    "test:recovery": "node --test tests/recovery/unit.test.mjs",
    "test:recovery:db": "node --test --test-concurrency=1 tests/recovery/database.test.mjs",
    "recovery": "node scripts/recovery/cli.mjs",
    "test:recovery:setup": "node tests/recovery/setup.cjs",
    "test:recovery:handler": "node --test tests/recovery/handler.test.mjs",
    "test:recovery:browser": "node --test tests/recovery/browser.test.mjs",
    "test:security:setup": "node tests/security/setup.cjs",
    "test:security": "node --test --test-concurrency=1 tests/security/database.test.cjs tests/security/auth.test.cjs tests/security/privacy.test.cjs",
    "test:security:browser": "node --test --test-concurrency=1 tests/security/browser.test.cjs",
    "security:scan": "node scripts/security-scan.cjs",
    "privacy:inspect": "node scripts/privacy/inspect-local.cjs",
    "lint": "eslint src",
    "dev": "vite",
    "test:static": "node --test tests/config/*.test.cjs tests/recovery/unit.test.mjs tests/recovery/cron.test.cjs tests/security/privacy.test.cjs tests/performance/safety.test.cjs",
    "check": "node scripts/check.cjs",
    "security:audit": "npm audit --audit-level=moderate",
    "test:database:build": "node scripts/database-proof.cjs",
    "schema:diff": "node scripts/schema-diff.cjs",
    "schema:capture": "node scripts/schema-capture.cjs",
    "test:build:browser": "node tests/browser/build-smoke.cjs",
    "test:performance": "node --test --test-concurrency=1 tests/performance/data.test.mjs tests/performance/browser.test.cjs",
    "perf:profile": "node tests/performance/browser-profile.cjs",
    "perf:load": "node tests/performance/load.mjs",
    "perf:seed": "node tests/performance/large-data.cjs"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "private": true,
  "packageManager": "npm@11.19.0"
}
